local rockspec_revision = "@PACKAGE_REVISION@"
local package_version = "@PACKAGE_VERSION@"
local dev_branch = "@PACKAGE_DEV_BRANCH@"

local is_dev_package = package_version == "dev" or
                       package_version == "scm" or
                       package_version == "cvs" or
                       package_version == "git" or
                       package_version == "svn" or
                       package_version == "hg"

package = "@PACKAGE_NAME@"
version = package_version .. "-" .. rockspec_revision

source = {
   url = [=[@PACKAGE_SOURCE_URL@]=],
   branch = is_dev_package and dev_branch or nil,
   tag = (not is_dev_package) and ("v" .. package_version) or nil
}

description = {
   homepage = [=[@PACKAGE_HOMEPAGE_URL@]=],
   license = "MIT",
   summary = [[PCG random number generators for Lua]],
   detailed = [=[@PACKAGE_NAME@ implements methods of the PCG algorithms for Lua. PCG is a family of simple fast space-efficient statistically good algorithms designed in 2014 by Dr. M. E. O'Neill for random number generation.

Visit the repository for more information.]=]
}

dependencies = {
   "lua >= 5.1"
}

build = {
   type = "builtin",
   modules = {
      ["@PACKAGE_NAME@"] = {
         sources = { "src/@PACKAGE_NAME@.c" },
         defines = { "NDEBUG", "_NDEBUG", "LUA_PCG_BUILD_SHARED" },
         incdirs = { "src" }
      }
   }
}